ctrl_interface=/var/run/wpa_supplicant
country=DE

# Copy to wpa_supplicant.conf and replace values; FAT32 permissions use mount masks.
# On Linux, keep the data partition root-only. The service makes a private RAM copy.
# This example is not used automatically.
network={
    ssid="YOUR_2G4_WIFI"
    psk="REPLACE_WITH_YOUR_PASSWORD"
}
