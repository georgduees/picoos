# Keep the CPU-count boot logos, with project artwork installed by external.mk.
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# Bluetooth UART, classic HID and BLE HID; evdev/joydev expose gamepads to SDL.
CONFIG_BT=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=m
CONFIG_BT_HIDP=m
CONFIG_UHID=m
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=m
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# VC4 HDMI needs its DDC I2C controller before it can bind.
CONFIG_DRM=y
CONFIG_DRM_VC4=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_I2C_BCM2835=m

# Storage/filesystems: SD card, ext4 system, FAT32 data and USB mass storage.
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# No RAID, SATA, network filesystems or alternative filesystem stacks.
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_BCACHE is not set
# CONFIG_BCACHEFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_CIFS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_XFS_FS is not set

# No camera, capture card, broadcast TV or DVB hardware is part of this console.
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DVB_CORE is not set

# The Zero 2 W uses onboard Broadcom SDIO Wi-Fi, not wired Ethernet NICs.
# CONFIG_NET_VENDOR_ALACRITECH is not set
# CONFIG_NET_VENDOR_AMAZON is not set
# CONFIG_NET_VENDOR_AQUANTIA is not set
# CONFIG_NET_VENDOR_ARC is not set
# CONFIG_NET_VENDOR_ASIX is not set
