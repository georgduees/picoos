#!/bin/sh

case "$1" in
	start)
		/usr/bin/psplash &
		echo "$!" > /run/psplash.pid
		;;
	stop)
		if [ -f /run/psplash.pid ]; then
			if ! /usr/bin/psplash-write "QUIT"; then
				echo "Failed to stop psplash via its control FIFO." >&2
				exit 1
			fi
			rm -f /run/psplash.pid
		fi
		;;
	*)
		echo "Usage: $0 {start|stop}" >&2
		exit 1
		;;
esac
