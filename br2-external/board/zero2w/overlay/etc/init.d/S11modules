#!/bin/sh

MODULES_DIR=${PICOOS_MODULES_DIR:-/etc/modules-load.d}

start() {
    result=0
    for file in "$MODULES_DIR"/*.conf; do
        [ -f "$file" ] || continue
        while read -r module args; do
            case "$module" in
                ""|"#"*) continue ;;
            esac
            # Module arguments are whitespace-separated in modules-load.d.
            if ! modprobe -q "$module" $args; then
                echo "PicoOS: failed to load module $module" >&2
                result=1
            fi
        done < "$file"
    done
    return "$result"
}

case "${1:-}" in
    start|restart|reload) start ;;
    # Unloading active VC4/Bluetooth/WLAN drivers can hang shutdown.
    stop) : ;;
    *) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
