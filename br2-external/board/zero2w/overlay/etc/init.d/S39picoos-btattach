#!/bin/sh

DAEMON=btattach
PIDFILE=/run/$DAEMON.pid
CONFIG=/etc/default/picoos-btattach
BTATTACH_DEVICE=/dev/ttyS1
BTATTACH_PROTOCOL=bcm
BTATTACH_BAUD=115200
BTATTACH_NOFLOW=0

[ -r "$CONFIG" ] && . "$CONFIG"

start() {
	printf 'Starting %s: ' "$DAEMON"
	if [ -e /sys/class/bluetooth/hci0 ]; then
		echo "OK (controller already attached)"
		return 0
	fi
	if [ ! -c "$BTATTACH_DEVICE" ]; then
		echo "FAIL"
		echo "$DAEMON: missing serial device $BTATTACH_DEVICE" >&2
		return 1
	fi
	set -- -B "$BTATTACH_DEVICE" -P "$BTATTACH_PROTOCOL" -S "$BTATTACH_BAUD"
	if [ "$BTATTACH_NOFLOW" = 1 ]; then
		set -- "$@" -N
	fi
	start-stop-daemon --start --background --make-pidfile \
		--pidfile "$PIDFILE" --exec "/usr/bin/$DAEMON" -- "$@"
	status=$?
	if [ "$status" -ne 0 ]; then
		echo "FAIL"
		return "$status"
	fi
	for _ in 1 2 3 4 5; do
		[ -e /sys/class/bluetooth/hci0 ] && { echo "OK"; return 0; }
		sleep 1
	done
	echo "FAIL"
	start-stop-daemon --stop --pidfile "$PIDFILE" --exec "/usr/bin/$DAEMON" >/dev/null 2>&1 || true
	rm -f "$PIDFILE"
	echo "$DAEMON: controller not attached on $BTATTACH_DEVICE" >&2
	return 1
}

stop() {
	printf 'Stopping %s: ' "$DAEMON"
	start-stop-daemon --stop --pidfile "$PIDFILE" --exec "/usr/bin/$DAEMON"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
		return "$status"
	fi
	while start-stop-daemon --stop --test --quiet --pidfile "$PIDFILE" \
		--exec "/usr/bin/$DAEMON"; do
		sleep 0.1
	done
	rm -f "$PIDFILE"
	return "$status"
}

restart() {
	stop
	start
}

case "$1" in
	start|stop|restart)
		"$1";;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac
