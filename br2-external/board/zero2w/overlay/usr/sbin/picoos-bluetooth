#!/bin/sh
set -eu

DATA_DIR=${PICOOS_BLUETOOTH_DATA_DIR:-/data}
STATE_DIR=${PICOOS_BLUETOOTH_STATE_DIR:-/var/lib/bluetooth}
MOUNTS_FILE=${PICOOS_BLUETOOTH_MOUNTS_FILE:-/proc/mounts}
DATA_STATE_DIR="$DATA_DIR/bluetooth"

fail() {
    echo "picoos-bluetooth: $*" >&2
    exit 1
}

prepare() {
    awk -v mount="$DATA_DIR" '$2 == mount { found = 1 } END { exit !found }' \
        "$MOUNTS_FILE" || fail "$DATA_DIR is not mounted; refusing non-persistent pairing state"

    if [ -L "$STATE_DIR" ]; then
        [ "$(readlink "$STATE_DIR")" = "$DATA_STATE_DIR" ] &&
            [ -d "$DATA_STATE_DIR" ] ||
            fail "$STATE_DIR is not the expected persistent-state link"
        return
    fi

    if [ -e "$STATE_DIR" ]; then
        [ -d "$STATE_DIR" ] && [ -z "$(ls -A "$STATE_DIR")" ] ||
            fail "$STATE_DIR already contains unexpected data"
        rmdir "$STATE_DIR"
    fi

    mkdir -p "$DATA_STATE_DIR"
    ln -s "$DATA_STATE_DIR" "$STATE_DIR"
}

case "${1:-}" in
    prepare) prepare ;;
    *) echo "Usage: $0 prepare" >&2; exit 1 ;;
esac
