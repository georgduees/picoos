#!/bin/sh
# Persistent runtime state: an ext4 image on the FAT32 data partition, loop-mounted
# at /persist. FAT32 cannot hold Unix modes, symlinks or names such as "B8:27:...".
set -eu

DATA_DIR=${PICOOS_STATE_DATA_DIR:-/data}
IMAGE=${PICOOS_STATE_IMAGE:-$DATA_DIR/picoos-state.img}
MOUNT_DIR=${PICOOS_STATE_MOUNT_DIR:-/persist}
IMAGE_MIB=${PICOOS_STATE_IMAGE_MIB:-16}
MOUNTS_FILE=${PICOOS_STATE_MOUNTS_FILE:-/proc/mounts}
SKIP_MOUNT=${PICOOS_STATE_SKIP_MOUNT:-0}
ROOT_PREFIX=${PICOOS_STATE_ROOT_PREFIX:-}

# name:path; each directory is linked from the path the service expects.
LINKS="bluetooth:/var/lib/bluetooth"

fail() {
    echo "picoos-state: $*" >&2
    exit 1
}

is_mounted() {
    awk -v mount="$1" '$2 == mount { found = 1 } END { exit !found }' "$MOUNTS_FILE"
}

create_image() {
    tmp="$IMAGE.new"
    rm -f "$tmp"
    dd if=/dev/zero of="$tmp" bs=1M count="$IMAGE_MIB" 2>/dev/null
    mke2fs -q -t ext4 -L PICOOS-STATE -m 0 "$tmp" ||
        { rm -f "$tmp"; fail "could not create $IMAGE"; }
    sync
    mv "$tmp" "$IMAGE"
    sync
}

mount_image() {
    is_mounted "$MOUNT_DIR" && return
    mkdir -p "$MOUNT_DIR"
    if command -v e2fsck >/dev/null 2>&1; then
        e2fsck -p "$IMAGE" >/dev/null 2>&1 || [ $? -lt 4 ] ||
            fail "$IMAGE is damaged; move it aside to start with empty state"
    fi
    mount -t ext4 -o loop,nosuid,nodev,noatime "$IMAGE" "$MOUNT_DIR" ||
        fail "could not mount $IMAGE"
    chmod 0700 "$MOUNT_DIR"
}

link_dir() {
    name=$1
    state_path=$ROOT_PREFIX$2
    target=$MOUNT_DIR/$name
    mkdir -p "$target"
    chmod 0700 "$target"

    if [ -L "$state_path" ]; then
        [ "$(readlink "$state_path")" = "$target" ] ||
            fail "$state_path is not the expected persistent-state link"
        return
    fi
    if [ -e "$state_path" ]; then
        [ -d "$state_path" ] && [ -z "$(ls -A "$state_path")" ] ||
            fail "$state_path already contains unexpected data"
        rmdir "$state_path"
    fi
    mkdir -p "$(dirname "$state_path")"
    ln -s "$target" "$state_path"
}

prepare() {
    is_mounted "$DATA_DIR" ||
        fail "$DATA_DIR is not mounted; refusing non-persistent state"
    [ -f "$IMAGE" ] || create_image
    [ "$SKIP_MOUNT" = 1 ] || mount_image
    for entry in $LINKS; do
        link_dir "${entry%%:*}" "${entry#*:}"
    done
}

case "${1:-}" in
    prepare) prepare ;;
    create) [ -f "$IMAGE" ] || create_image ;;
    *) echo "Usage: $0 prepare" >&2; exit 1 ;;
esac
