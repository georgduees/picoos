CONFIG_DEFAULT_CONFIG_FILE="/etc/swupdate.cfg"
CONFIG_SOCKET_CTRL_PATH="/run/picoos-update.lock/control"
CONFIG_SOCKET_PROGRESS_PATH="/run/picoos-update.lock/progress"
CONFIG_SOCKET_REMOTE_HANDLER_DIRECTORY="/run/picoos-update.lock/"
CONFIG_SCRIPTS=y
CONFIG_HW_COMPATIBILITY=y
CONFIG_HW_COMPATIBILITY_FILE="/etc/hwrevision"
CONFIG_UBOOT=y
CONFIG_UBOOT_FWENV="/etc/fw_env.config"
CONFIG_UBOOT_DEFAULTENV="/etc/u-boot-initial-env"
CONFIG_BOOTLOADER_DEFAULT_UBOOT=y
CONFIG_BOOTLOADER_STATIC_LINKED=y
CONFIG_BOOTLOADERHANDLER=y
CONFIG_SSL_IMPL_OPENSSL=y
CONFIG_HASH_VERIFY=y
CONFIG_SIGNED_IMAGES=y
CONFIG_SIGALG_RAWRSA=y
# CONFIG_WEBSERVER is not set
# CONFIG_SURICATTA is not set
# CONFIG_DOWNLOAD is not set
CONFIG_LIBCONFIG=y
CONFIG_RAW=y
CONFIG_SHELLSCRIPTHANDLER=y
