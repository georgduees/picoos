boot_slot=A
stable_slot=A
upgrade_available=0
bootcount=0
bootlimit=3
ustate=0
kernel_addr_r=0x01000000
fdt_addr_r=0x02600000
overlay_addr_r=0x02700000
stdin=serial,usbkbd
stdout=serial,vidconsole
stderr=serial,vidconsole
rollback=setenv boot_slot ${stable_slot}; setenv upgrade_available 0; setenv bootcount 0; setenv recovery_status; setenv ustate 3; saveenv
select_slot=if test "${stable_slot}" != A && test "${stable_slot}" != B; then echo Invalid stable slot; reset; fi; if test "${recovery_status}" = in_progress || test "${recovery_status}" = failed; then if run rollback; then true; else reset; fi; fi; if test "${boot_slot}" != A && test "${boot_slot}" != B; then run rollback; fi
load_slot=if test "${boot_slot}" = A; then setenv rootpart 2; else setenv rootpart 3; fi; setenv bootargs root=/dev/mmcblk0p${rootpart} rootwait console=tty1 console=ttyAMA0,115200 picoos.slot=${boot_slot} watchdog.open_timeout=60; ext4load mmc 0:${rootpart} ${kernel_addr_r} /boot/zImage && ext4load mmc 0:${rootpart} ${fdt_addr_r} /boot/bcm2710-rpi-zero-2-w.dtb && ext4load mmc 0:${rootpart} ${overlay_addr_r} /boot/overlays/miniuart-bt.dtbo && fdt addr ${fdt_addr_r} && fdt resize 0x10000 && fdt apply ${overlay_addr_r}
picoos_boot=if run select_slot && run load_slot; then bootz ${kernel_addr_r} - ${fdt_addr_r}; fi; if run rollback && run load_slot; then bootz ${kernel_addr_r} - ${fdt_addr_r}; fi; reset
bootcmd=run picoos_boot
altbootcmd=if run rollback; then run picoos_boot; else reset; fi
