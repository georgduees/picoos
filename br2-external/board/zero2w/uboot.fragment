# CONFIG_ENV_IS_IN_FAT is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_OFFSET=0x40000
CONFIG_ENV_OFFSET_REDUND=0x60000
CONFIG_ENV_MMC_DEVICE_INDEX=0
CONFIG_ENV_MMC_EMMC_HW_PARTITION=0
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="run picoos_boot"
CONFIG_BOOTDELAY=0
CONFIG_CMD_EXT4=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_FDT=y
CONFIG_CMD_SAVEENV=y
CONFIG_HUSH_PARSER=y
# CONFIG_VIDEO_LOGO is not set
# CONFIG_SPLASH_SCREEN is not set
CONFIG_WDT=y
CONFIG_WDT_BCM2835=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=15000
